# BDDK MCP Server - Environment Variables
# Copy this file to .env and fill in your values.

# Public-profile PostgreSQL connection. The LOGIN must inherit exactly
# bddk_public_reader; startup rejects broader or different application access.
BDDK_DATABASE_URL=postgresql://user:password@localhost:5432/bddk

# The operator profile requires a distinct LOGIN inheriting exactly
# bddk_public_reader, bddk_ingestion, and bddk_operator_runtime. It never falls
# back to BDDK_DATABASE_URL, and startup verifies its effective privileges.
# BDDK_OPERATOR_DATABASE_URL=postgresql://operator:password@localhost:5432/bddk

# Lifecycle jobs require distinct identities and never fall back to the public
# serving DSN. The schema owner runs only `bddk-mcp migrate`; ingestion runs
# `bddk-mcp bootstrap`, document sync, section rebuilds, and corpus backfills.
# The migration connection must execute SET ROLE bddk_schema_owner; see
# deploy/postgres/README.md. Extensions and post-migration grants remain DBA work.
# BDDK_SCHEMA_OWNER_DATABASE_URL=postgresql://schema_owner:password@localhost:5432/bddk?options=-c%20role%3Dbddk_schema_owner
# Independent lifecycle guard; it must match current_database() and must be
# supplied separately from every DSN.
# BDDK_EXPECTED_DATABASE_NAME=bddk
# Verified database TLS is the default. Only isolated loopback/Compose
# development may opt out explicitly:
# BDDK_ALLOW_INSECURE_DATABASE=false
# The ingestion LOGIN must inherit exactly bddk_ingestion; bootstrap verifies it.
# BDDK_INGESTION_DATABASE_URL=postgresql://ingestion:password@localhost:5432/bddk

# Connection pool
BDDK_PG_POOL_MIN=2
BDDK_PG_POOL_MAX=10

# Embedding model (offline-first: set path to pre-downloaded model)
# BDDK_EMBEDDING_MODEL_PATH=/path/to/local/model
# BDDK_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# A remote custom model must also set an immutable full commit revision. The
# built-in model is pinned to d13f1b27baf31030b7fd040960d60d909913633f;
# the container downloads that revision and saves it at /app/embedding_model.
# BDDK_EMBEDDING_MODEL_REVISION=d13f1b27baf31030b7fd040960d60d909913633f
# The current immutable schema is public.vector(768). Any other value is
# rejected at configuration load; changing models requires a controlled,
# validated re-embedding rather than only changing this environment variable.
# BDDK_EMBEDDING_DIM=768

# Optional reranker (disabled by default). A remote custom model likewise
# requires an immutable full commit revision; a local path needs no revision.
# The built-in reranker revision is 1427fd652930e4ba29e8149678df786c240d8825.
# BDDK_RERANKER=false
# BDDK_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# BDDK_RERANKER_MODEL_REVISION=1427fd652930e4ba29e8149678df786c240d8825
# BDDK_RERANKER_MODEL_PATH=/path/to/local/reranker

# Cache
# BDDK_CACHE_TTL=3600
# BDDK_SEARCH_CACHE_TTL=300

# Sync
# BDDK_AUTO_SYNC=false
# Serving rejects BDDK_AUTO_SYNC=true. Run `bddk-mcp migrate` with the schema
# owner, apply DBA grants, then run `bddk-mcp bootstrap` with ingestion.

# Runtime tool profile: public exposes 15 tools; operator exposes 28 tools
# (15 public + 13 operator) in a separate process with the operator DSN.
# BDDK_TOOL_PROFILE=public

# Transport: stdio is the default. Streamable HTTP uses stateless JSON responses
# at /mcp and fixed, content-free probes at /health/live and /health/ready.
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# PORT=8000

# A non-loopback HTTP bind fails closed unless exact Host/HTTPS Origin allowlists
# and every JWT setting below are supplied. Values are deployment-specific;
# obtain them from the approved identity design rather than repository tests.
# BDDK_HTTP_ALLOWED_HOSTS=
# BDDK_HTTP_ALLOWED_ORIGINS=
# BDDK_JWT_ISSUER=
# BDDK_JWT_RESOURCE=
# BDDK_JWT_JWKS_URL=
# BDDK_JWT_AUDIENCE=
# BDDK_JWT_REQUIRED_SCOPES=bddk.read
# BDDK_JWT_ALGORITHMS=RS256
# RFC 9068 at+jwt is the fail-closed default. Add generic JWT only as an
# approved Keycloak compatibility opt-in with a dedicated API audience.
# BDDK_JWT_ACCESS_TOKEN_TYPES=at+jwt
# BDDK_JWT_MAX_TOKEN_LENGTH=16384

# Optional HTTPS at the application socket. Configure both or neither; startup
# validates that the PEM certificate and unencrypted key are readable and
# matched. The OpenShift starter injects these from service-serving Secrets.
# BDDK_TLS_CERT_FILE=/var/run/secrets/bddk-mcp/tls/tls.crt
# BDDK_TLS_KEY_FILE=/var/run/secrets/bddk-mcp/tls/tls.key

# Remote operator HTTP additionally requires bddk.operator in the required
# scopes and this explicit opt-in. Keep false/unset for local operator stdio.
# BDDK_OPERATOR_REMOTE_ENABLED=false

# Coarse HTTP safeguards. These counters are process-local, not shared across
# workers/replicas and not a replacement for deployment-wide ingress limits.
# BDDK_HTTP_MAX_BODY_BYTES=1048576
# BDDK_HTTP_MAX_CONCURRENCY=32
# BDDK_HTTP_RATE_LIMIT_PER_MINUTE=120

# Regulatory outbound fetches accept only exact BDDK/mevzuat HTTPS hosts,
# revalidate bounded redirects and public DNS answers, and enforce code-owned
# streaming size limits. DNS validation cannot remove DNS-to-connect races;
# bank/OpenShift deployments still require an approved egress allowlist/proxy.
# BDDK_REQUEST_TIMEOUT=60.0
# BDDK_HTTP_CONNECT_TIMEOUT=10.0
# BDDK_HTTP_POOL_TIMEOUT=10.0
# BDDK_MAX_RETRIES=3

# Sync and durable operator job lifecycle. Sync concurrency is unrelated to
# HTTP concurrency. Job records, idempotency digests, numeric progress, and
# terminal history are stored in bddk_operator.operator_jobs. A PostgreSQL
# session advisory lease serializes corpus mutation across processes. Runner
# task execution remains process-local and is lost on restart; the durable job
# record is not. Queued recovery/multi-replica failover has
# not been accepted for the bank target; keep the supplied operator at one
# Recreate replica. The operator pool must have at least two connections.
# BDDK_SYNC_CONCURRENCY=5
# BDDK_OPERATOR_JOB_HISTORY=1000
# BDDK_OPERATOR_JOB_DRAIN_TIMEOUT=30

# Optional privacy-safe retrieval telemetry. Disabled by default.
# Stores hashed/summarized tool args, latency, result counts, doc IDs, quality
# labels, and relevance stats in tool_call_traces. Raw query/prompt text is
# never stored unless BDDK_TELEMETRY_STORE_TEXT=true is explicitly set.
# BDDK_TELEMETRY_ENABLED=false
# Required when telemetry is enabled; the distinct LOGIN must inherit only
# bddk_telemetry_writer. Startup verifies the exact column-scoped INSERT-only
# contract and rejects trace reads, updates, deletes, DDL, or broader membership.
# BDDK_TELEMETRY_DATABASE_URL=postgresql://telemetry_writer:password@localhost:5432/bddk
# BDDK_TELEMETRY_STORE_TEXT=false
# BDDK_TELEMETRY_MODEL_ID=
# BDDK_TELEMETRY_SESSION_ID=

# MCP tool-boundary logs contain metadata only by default: tool name, status,
# latency, argument sizes/counts, result size, and error type. For short-lived
# local debugging only, this explicit opt-in adds truncated argument/result/error
# previews and may expose confidential queries or regulatory content.
# Never enable it in shared, bank, or production environments.
# BDDK_TOOL_LOG_CONTENT=false
