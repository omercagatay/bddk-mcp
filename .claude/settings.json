{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(railway deployment list *)",
      "Bash(railway logs *)",
      "Bash(railway status *)",
      "Bash(railway whoami *)",
      "Bash(railway config plan *)",
      "mcp__railway",
      "Bash(uv run pytest tests/*)",
      "PowerShell(uv run pytest tests/*)",
      "Bash(uv run ruff check .)",
      "PowerShell(uv run ruff check .)",
      "Bash(uv run ruff format --check .)",
      "PowerShell(uv run ruff format --check .)",
      "Bash(uv run python scripts/check_repository_hygiene.py)",
      "PowerShell(uv run python scripts/check_repository_hygiene.py)",
      "Bash(uv lock --check)",
      "PowerShell(uv lock --check)"
    ],
    "deny": [
      "Bash(uv run pytest *--basetemp*)",
      "PowerShell(uv run pytest *--basetemp*)",
      "Bash(uv run pytest *--pastebin*)",
      "PowerShell(uv run pytest *--pastebin*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "top=$(git rev-parse --show-toplevel) || exit 0; cd \"$top\" && { uv run ruff check . && uv run ruff format --check .; } >&2 || exit 2",
            "statusMessage": "Running ruff checks before commit"
          },
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "top=$(git rev-parse --show-toplevel) || exit 0; cd \"$top\" && { uv run ruff check . && uv run ruff format --check .; } >&2 || exit 2",
            "statusMessage": "Running ruff checks before commit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-sync --project \"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_after_edit.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && uv sync --dev 2>/dev/null && echo 'Dependencies ready'"
          }
        ]
      }
    ]
  }
}
