# Optional break-glass alternative to exporting the values before invoking
# compose-current-key.sh. Copy this to .env, restrict it to the owner
# (chmod 600), and never commit the populated file.
OPENAI_API_KEY=replace-with-current-open-webui-provider-key
# Read-only bank directory service account used for LDAP user lookup.
LDAP_APP_PASSWORD=replace-with-ldap-service-account-password
