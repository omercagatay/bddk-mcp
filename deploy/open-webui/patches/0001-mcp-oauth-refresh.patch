+OAuthAccessTokenGetter = Callable[[bool, Optional[str]], Awaitable[Optional[str]]]
+
+
+class RefreshingBearerAuth(httpx.Auth):
+    """Resolve a per-user OAuth token for every MCP HTTP request.
+
+    Open WebUI keeps MCP connections alive for an entire model/tool loop. A static
+    Authorization header therefore outlives short access tokens. This adapter reads
+    the encrypted OAuth session on each request and performs one safe replay when the
+    resource server rejects a token with 401. The refresh token remains owned and
+    persisted by OAuthClientManager; it is never copied into the transport.
+    """
+
+    def __init__(self, token_getter: OAuthAccessTokenGetter):
+        self._token_getter = token_getter
+
+    @staticmethod
+    def _access_token(value: Optional[str]) -> Optional[str]:
+        return value.strip() if isinstance(value, str) and value.strip() else None
+
+    async def async_auth_flow(self, request: httpx.Request) -> AsyncGenerator[httpx.Request, httpx.Response]:
+        # Never allow a stale/custom bearer value to win over the user's current
+        # encrypted OAuth session.
+        request.headers.pop('Authorization', None)
+        access_token = self._access_token(await self._token_getter(False, None))
+        if access_token is None:
+            raise RuntimeError('MCP OAuth authorization is required.')
+
+        request.headers['Authorization'] = f'Bearer {access_token}'
+        response = yield request
+        if response.status_code != 401:
+            return
+
+        # Authentication is rejected before the MCP request body is processed, so
+        # replaying the buffered JSON request exactly once is safe. Reading the 401
+        # body releases its connection before the retry.
+        await response.aread()
+        refreshed_access_token = self._access_token(await self._token_getter(True, access_token))
+        if refreshed_access_token is None:
+            return
+
+        request.headers['Authorization'] = f'Bearer {refreshed_access_token}'
+        yield request
+
+
